# Copie para .env.local e preencha. NÃO commitar valores reais.

# Supabase (Database + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (tradução, chunks, geração da música e análise de clareza da fala)
# A chave fica somente no servidor; nunca use prefixo NEXT_PUBLIC_.
OPENAI_API_KEY=

# Public canonical URL. Required only by maintenance/transcript helpers that
# call the deployed app itself; the normal static lesson flow does not use it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional — usado só por scripts de curadoria/migração local
DATABASE_URL=

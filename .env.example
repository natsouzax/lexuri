# Copie para .env.local e preencha. NÃO commitar valores reais.

# Supabase (Database + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (tap-to-translate, análise de chunks)
OPENAI_API_KEY=

# Azure Speech — Pronunciation Assessment
# Crie um recurso Speech F0 e copie os valores de "Keys and Endpoint".
# A chave fica somente no servidor; nunca use prefixo NEXT_PUBLIC_.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_ENDPOINT=
# Prosody tem cobrança adicional no plano pago. Mantenha false no MVP gratuito.
AZURE_SPEECH_PROSODY=false

# Opcional — usado só por scripts de curadoria/migração local
DATABASE_URL=

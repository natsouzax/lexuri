# Copie para .env.local e preencha. NÃO commitar valores reais.

# Supabase (Database + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (tradução, chunks, geração da música e análise de clareza da fala)
